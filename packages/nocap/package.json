{
  "name": "@makehash/nocap",
  "version": "0.3.0",
  "description": "Link spec docs to tests, and track which specs are not verified yet",
  "keywords": [
    "spec",
    "coverage",
    "traceability",
    "requirements",
    "testing",
    "markdown",
    "cli"
  ],
  "license": "MIT",
  "author": "hash_kim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makeUgreat/nocap.git",
    "directory": "packages/nocap"
  },
  "homepage": "https://github.com/makeUgreat/nocap#readme",
  "bugs": "https://github.com/makeUgreat/nocap/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "nocap": "dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint:deps": "depcruise src --config dependency-cruiser/config.ts",
    "lint:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@swc/core": "^1.16.21",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "oxc-parser": "^0.156.0",
    "tinyglobby": "^0.2.17"
  }
}
