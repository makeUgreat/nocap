{
  "name": "nocap-monorepo",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:deps": "pnpm -r lint:deps",
    "lint": "oxlint",
    "nocap": "pnpm --filter nocap build && node packages/nocap/dist/bin.js --spec 'docs/specs/*.md' --test 'packages/nocap/src/**/*.test.ts' --test 'packages/nocap/test/**/*.integration-test.ts'",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  }
}
