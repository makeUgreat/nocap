{
  "name": "nocap-monorepo",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:deps": "pnpm -r lint:deps",
    "lint:package": "pnpm -r lint:package",
    "lint": "oxlint",
    "nocap": "pnpm --filter @makehash/nocap build && pnpm nocap:run",
    "nocap:run": "node npm/nocap/dist/bin.js --spec \"npm/nocap/docs/specs/*.md\" --test \"npm/nocap/src/**/*.test.ts\" --test \"npm/nocap/test/**/*.integration-test.ts\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  }
}
